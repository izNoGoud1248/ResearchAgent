# Copy with: uv run scripts/initEnv.py (fills the generated secrets for you)

OPENAI_API_KEY=
CHEAP_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o
OPENAI_REQUESTS_PER_MINUTE=60

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=researchdesk
POSTGRES_PASSWORD=
POSTGRES_DB=researchdesk

AGENT_SIGNING_SEED=
AGENT_PUBLIC_KEY=
SEARCH_HMAC_KEY=
NOTES_HMAC_KEY=
EVIL_HMAC_KEY=
LIBRARY_HMAC_KEY=
FACTCHECKER_SIGNING_SEED=
FACTCHECKER_PUBLIC_KEY=
USER_API_KEY=
APPROVER_API_KEY=
SESSION_SECRET=
# Set true when the UI is served over HTTPS.
COOKIE_SECURE=false

GATEWAY_URL=http://localhost:8100/mcp
SEARCH_URL=http://localhost:8101/mcp
NOTES_URL=http://localhost:8102/mcp
LIBRARY_URL=http://localhost:8103/mcp
FACTCHECKER_URL=http://localhost:8110
API_URL=http://localhost:8010

OTLP_ENDPOINT=http://localhost:4318
JAEGER_URL=http://localhost:16686
KIBANA_URL=http://localhost:5601
ELASTICSEARCH_URL=http://localhost:9200
LOG_RETENTION_DAYS=30
# Optional: Langfuse Cloud keys. LANGFUSE_BASE_URL is https://us.cloud.langfuse.com for the US region.
# Set COLLECTOR_CONFIG=collectorLangfuse.yaml to send traces there too.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_URL=
COLLECTOR_CONFIG=collector.yaml
